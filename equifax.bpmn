<textAnnotation id="a2"><text>Défaillance 2 : aucun seuil ne déclenche d&#x27;escalade vers le comité</text></textAnnotation><association id="as_a2" sourceRef="a2" targetRef="t3"/>
<textAnnotation id="a3"><text>Défaillance 3 : le scan ne détecte pas le système non corrigé</text></textAnnotation><association id="as_a3" sourceRef="a3" targetRef="t4"/>
